# Cadenas de conexión para aplicar migraciones. Copiar a .env.db.local y completar.
# .env.db.local está fuera de git (.gitignore ya cubre .env*).
#
# Sacarlas del dashboard: Settings -> Database -> Connection string -> Session pooler -> URI.
# Session pooler y no Direct connection: la directa es solo IPv6 y no se alcanza desde redes
# sin IPv6, que es el caso de esta máquina.
#
# OJO: la contraseña va percent-encodeada.  /  ->  %2F     &  ->  %26     @  ->  %40
DEV_DB_URL=postgresql://postgres.PEGAR-REF:PEGAR-PASSWORD@aws-0-PEGAR-REGION.pooler.supabase.com:5432/postgres
PROD_DB_URL=postgresql://postgres.PEGAR-REF:PEGAR-PASSWORD@aws-0-PEGAR-REGION.pooler.supabase.com:5432/postgres
